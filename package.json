{
  "name": "autoedge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx,.vue src",
    "lint:fix": "eslint --fix --ext .ts,.tsx,.js,.jsx,.vue src",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,vue,json,scss,css,md}\"",
    "build:test": "vue-tsc && vite build --mode test",
    "build:prod": "vue-tsc && vite build --mode production",
    "build": "npm run build:prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "lodash-es": "^4.17.22",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "mockjs": "^1.1.0",
    "sass-embedded": "^1.97.2",
    "terser": "^5.44.1",
    "typescript": "^5.3.3",
    "prettier": "^3.2.5",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.0",
    "@typescript-eslint/parser": "^6.5.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.4",
    "unocss": "^0.58.3",
    "vite": "^5.0.12",
    "vite-plugin-mock": "^3.0.2",
    "vue-tsc": "^1.8.27"
  }
}