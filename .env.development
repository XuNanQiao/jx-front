# 开发环境配置
# API 基础路径（留空或 '/api' 使用 Vite 代理，填写完整 URL 则直接请求后端）
# 使用代理（推荐，解决 CORS）：VITE_API_BASE_URL='' 或 VITE_API_BASE_URL='/api'
# 直接请求后端：VITE_API_BASE_URL='http://10.80.1.45:8000'
VITE_API_BASE_URL='/devapi'

# 代理目标地址（仅在使用代理时生效）
VITE_PROXY_TARGET='http://10.80.1.45:8000'

# 环境标识
VITE_APP_ENV='development'

# 其他配置
VITE_APP_TITLE='系统管理平台 - 开发环境'

# 是否启用 Mock 数据（true: 使用 Mock, false: 使用真实后端）
VITE_USE_MOCK='false'
